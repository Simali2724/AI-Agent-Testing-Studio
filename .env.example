# Studio judge: openai, claude, gemini, gemma, ollama, or custom.
# These settings belong to Studio, independently of the chatbot being tested.
STUDIO_JUDGE_PROVIDER=gemini

# Enter your judge account keys here. Model IDs must be available to that account.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMMA_MODEL=
OLLAMA_MODEL=

# Optional overrides for the selected judge. Leave empty to use provider settings.
# For a custom endpoint, set STUDIO_JUDGE_PROVIDER=custom and fill these fields.
STUDIO_JUDGE_URL=
STUDIO_JUDGE_MODEL=
STUDIO_JUDGE_API_KEY=

MAX_UPLOAD_MB=1024
TEST_TIMEOUT_SECONDS=60
MAX_TEST_CASES=200
