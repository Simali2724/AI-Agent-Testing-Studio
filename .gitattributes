# Additional defense for `git archive`; does not replace safe ZIP packaging.
.env export-ignore
.env.* export-ignore
**/.env export-ignore
**/.env.* export-ignore
.env.example -export-ignore
**/.env.example -export-ignore
.venv export-ignore
venv export-ignore
node_modules export-ignore
runtime export-ignore
runs export-ignore
dist export-ignore
*.zip export-ignore
*.pem export-ignore
*.key export-ignore
*.p12 export-ignore
*.pfx export-ignore
credentials*.json export-ignore
service-account*.json export-ignore

# Keep formatter output stable on Windows and in GitHub Actions.
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
